# Copy to .env.local and fill in. Never commit .env.local.

# Your OWN key from build.nvidia.com (each teammate uses their own — rate limit is ~40 req/min per key)
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Shared Neon connection string — the POOLED one (host contains "-pooler")
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# NWS asks for contact info in the User-Agent
NWS_USER_AGENT=Shore/0.1 (SteelHacks XIII; your-contact-here)
